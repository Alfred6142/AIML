from collections import deque


# Social network graph
graph = {
    "Alice": ["Charlie", "David"],
    "Charlie": ["Alice", "Emma"],
    "David": ["Alice", "Emma", "Fred"],
    "Emma": ["Charlie", "David", "Bob"],
    "Fred": ["David", "Bob"],
    "Bob": ["Emma", "Fred"]
}


# BFS Function
def bfs(graph, start, goal):
    queue = deque([[start]])
    visited = {start}

    while queue:
        path = queue.popleft()
        node = path[-1]

        print("BFS Visiting:", node)

        if node == goal:
            return path

        for neighbor in sorted(graph[node]):
            if neighbor not in visited:
                visited.add(neighbor)
                new_path = path + [neighbor]
                queue.append(new_path)

    return None


# DFS Function
def dfs(graph, start, goal):
    stack = [[start]]
    visited = set()

    while stack:
        path = stack.pop()
        node = path[-1]

        if node not in visited:
            visited.add(node)

            print("DFS Visiting:", node)

            if node == goal:
                return path

            # Reverse sorting is used because Stack follows LIFO
            for neighbor in sorted(graph[node], reverse=True):
                if neighbor not in visited:
                    new_path = path + [neighbor]
                    stack.append(new_path)

    return None


# Source and Goal Nodes
start = "Alice"
goal = "Bob"


# Run BFS
bfs_path = bfs(graph, start, goal)

print("\nFinal BFS Path:", " -> ".join(bfs_path))


print()


# Run DFS
dfs_path = dfs(graph, start, goal)

print("\nFinal DFS Path:", " -> ".join(dfs_path))
